DB_NAME=  // your database name
DB_USER= // your database user
DB_PASSWORD= // your database password
DB_HOST= // your database host
DB_PORT= // your database port
PORT= // your server port
NODE_ENV= // your node environment

# Optional: Sequelize connection pool tuning (sane defaults are used if unset)
# DB_POOL_MAX= // max simultaneous DB connections (default 10)
# DB_POOL_MIN= // min idle DB connections kept open (default 0)
# DB_POOL_ACQUIRE_MS= // ms to wait for a connection before erroring (default 30000)
# DB_POOL_IDLE_MS= // ms a connection can sit idle before being released (default 10000)

# Required. The server refuses to start if this is unset - there is no
# insecure fallback, so don't leave it blank outside local scratch use.
JWT_SECRET= // your jwt secret
EXPIRES_IN= // your jwt expiry, e.g. 1h (defaults to 1h if unset)

# REDIS_HOST= // your redis host
# REDIS_PORT= // your redis port
# REDIS_PASSWORD= // your redis password
# REDIS_TTL_SECONDS= // default cache TTL in seconds (default 300)

